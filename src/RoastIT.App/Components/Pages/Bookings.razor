@page "/bookings"
@implements IDisposable
@inject BookingService BookingData
@inject DashboardService Dashboards
@inject BookingScopeState Scope
@inject IChangeNotifier Changes
@inject ToastService Toasts
@inject IBusinessCalendar Calendar

<PageHeading Title="Bookings" Subtitle="@BookingFormat.LongDate(Scope.Today)" />

<DateStrip Scope="Scope" Counts="_countsByDate" OnOpenCalendar="OpenCalendar" />

<div class="scope">Showing <strong>@BookingFormat.ScopeLabel(Scope.SelectedDate, Scope.Today)</strong></div>

<div class="segmented" role="tablist">
    <button type="button" role="tab" class="seg @(Scope.ActiveTab == BookingTab.Dashboard ? "active" : null)"
            aria-selected="@(Scope.ActiveTab == BookingTab.Dashboard ? "true" : "false")" @onclick="() => Scope.SetTab(BookingTab.Dashboard)">Dashboard</button>
    <button type="button" role="tab" class="seg @(Scope.ActiveTab == BookingTab.List ? "active" : null)"
            aria-selected="@(Scope.ActiveTab == BookingTab.List ? "true" : "false")" @onclick="() => Scope.SetTab(BookingTab.List)">Booking list</button>
</div>

@if (Scope.ActiveTab == BookingTab.Dashboard)
{
    if (_dashboard is { } data)
    {
        <DashboardTab Data="data" Date="Scope.SelectedDate" />
    }
}
else
{
    <BookingListTab Scope="Scope" Rows="_rows" StatusCounts="_statusCounts" OnOpen="OpenDetail" OnAdvance="RequestAdvance" OnOpenSort="OpenSort" />
}

@if (!_createdOpen)
{
    <Fab Label="New booking" OnClick="OpenNew" />
}

<BookingDetailSheet Open="_detailOpen" BookingId="@_detailId" OnClose="CloseDetail" OnSelect="SelectBooking" />

<NewBookingSheet Open="_newOpen" OnClose="CloseNew" Scope="Scope" Counts="_countsByDate" OnCreated="ShowCreated" />

<BookingSortSheet Open="_sortOpen" OnClose="CloseSort"
                  Field="Scope.SortField" FieldChanged="OnSortField"
                  Direction="Scope.SortDirection" DirectionChanged="OnSortDirection" />

<CalendarSheet Open="_calendarOpen" OnClose="CloseCalendar" Scope="Scope" Counts="_countsByDate" />

<ConfirmDialog Open="_advanceRow is not null" OnClose="CancelAdvance" Title="Update status?"
               Message="@AdvanceMessage" ConfirmLabel="@AdvanceLabel" OnConfirm="ConfirmAdvanceAsync" />

<BookingCreatedDialog Open="_createdOpen" Created="_created" OnClose="CloseCreated" />

@code {
    private IReadOnlyList<BookingRow> _rows = [];
    private BookingStatusCounts _statusCounts = new(0, 0, 0, 0, 0, 0);
    private IReadOnlyDictionary<DateOnly, int> _countsByDate = new Dictionary<DateOnly, int>();
    private DashboardData? _dashboard;
    private bool _detailOpen, _newOpen, _sortOpen, _calendarOpen, _createdOpen;
    private string? _detailId;
    private BookingRow? _advanceRow;
    private CreatedBooking? _created;
    private int _loadId;

    private string AdvanceLabel => _advanceRow is { } r ? ItemStatusRules.ActionLabel(r.Status) ?? "Update" : "Update";

    private string AdvanceMessage =>
        _advanceRow is { } r && ItemStatusRules.Next(r.Status) is { } next
            ? $"Mark booking {r.BookingId} as {ItemStatusRules.Label(next)}?"
            : "";

    protected override async Task OnInitializedAsync()
    {
        Scope.Changed += OnScopeChanged;
        Changes.BookingsChanged += OnBookingsChanged;
        Changes.OrderChanged += OnOrderChanged;
        Changes.CatalogChanged += OnCatalogChanged;
        Changes.DataReplaced += OnDataReplaced;
        await LoadAsync();
    }

    // ---- Loading ---------------------------------------------------------------

    private void OnScopeChanged() => Refresh();

    private void OnBookingsChanged(DateOnly date) => Refresh();

    private void OnOrderChanged(Guid orderKey) => Refresh();

    // A renamed product changes the cards (name, cooking time).
    private void OnCatalogChanged() => Refresh();

    // Import replaced the whole database (plan §10.5 step 7).
    private void OnDataReplaced() => Refresh();

    private void Refresh() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    // Only what the current scope shows is read (D21): one day's bookings when a date is selected, every booking only for
    // the "all dates" list; the chips, badges and Dashboard totals come from SQL counts.
    private async Task LoadAsync()
    {
        var id = ++_loadId;
        try
        {
            var date = Scope.SelectedDate;
            var listTab = Scope.ActiveTab == BookingTab.List;
            IReadOnlyList<BookingRow> rows = listTab ? await BookingData.ListAsync(date) : [];
            var statusCounts = listTab ? await BookingData.StatusCountsAsync() : _statusCounts;
            var countsByDate = await BookingData.CountsByDateAsync();
            var dashboard = listTab ? null : await Dashboards.GetAsync(date);
            if (id != _loadId) return; // a newer load is already on its way

            _rows = rows;
            _statusCounts = statusCounts;
            _countsByDate = countsByDate;
            _dashboard = dashboard;
        }
        catch (AccessDeniedException)
        {
            // Locked while loading: the lock screen takes over; the page reloads when shown again.
        }
    }

    // ---- Detail ----------------------------------------------------------------

    private void OpenDetail(BookingRow row)
    {
        _detailId = row.BookingId;
        _detailOpen = true;
    }

    private void SelectBooking(string bookingId) => _detailId = bookingId;

    private void CloseDetail() => _detailOpen = false;

    // ---- New booking and the created dialog -------------------------------------

    private void OpenNew() => _newOpen = true;

    private void CloseNew() => _newOpen = false;

    private void ShowCreated(CreatedBooking created)
    {
        _created = created;
        _createdOpen = true;
    }

    private void CloseCreated()
    {
        _createdOpen = false;
        _created = null;
    }

    // ---- Sort and calendar -----------------------------------------------------

    private void OpenSort() => _sortOpen = true;

    private void CloseSort() => _sortOpen = false;

    private void OnSortField(BookingSortField field) => Scope.SetSort(field);

    private void OnSortDirection(SortDirection direction) => Scope.SetSortDirection(direction);

    private void OpenCalendar()
    {
        Scope.OpenCalendar();
        _calendarOpen = true;
    }

    private void CloseCalendar() => _calendarOpen = false;

    // ---- Quick advance from a card: confirm first (bookings spec §7.4) -----------

    private void RequestAdvance(BookingRow row) => _advanceRow = row;

    private void CancelAdvance() => _advanceRow = null;

    private async Task ConfirmAdvanceAsync()
    {
        if (_advanceRow is not { } row) return;
        _advanceRow = null;
        try
        {
            var status = await BookingData.AdvanceStatusAsync(row.BookingId, row.Status);
            Toasts.Show($"{row.BookingId} → {ItemStatusRules.Label(status)}", ToastDuration.Bookings);
        }
        catch (StaleStateException ex)
        {
            Toasts.Show(ex.Message, ToastDuration.Bookings);
            await LoadAsync();
        }
        catch (ValidationException ex) { Toasts.Show(ex.Message, ToastDuration.Bookings); }
        catch (AccessDeniedException) { /* the app locked: the lock screen takes over */ }
    }

    public void Dispose()
    {
        Scope.Changed -= OnScopeChanged;
        Changes.BookingsChanged -= OnBookingsChanged;
        Changes.OrderChanged -= OnOrderChanged;
        Changes.CatalogChanged -= OnCatalogChanged;
        Changes.DataReplaced -= OnDataReplaced;
    }
}
