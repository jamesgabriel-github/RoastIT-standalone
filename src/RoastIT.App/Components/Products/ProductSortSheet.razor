@* "Sort products" bottom sheet (menu spec §4). Picking a field or direction applies at once; Done closes. *@
<BottomSheet Open="Open" OnClose="OnClose" Title="Sort products">
    <div>
        @foreach (var field in _fields)
        {
            var selected = field == Field;
            <button type="button" class="menu-row @(selected ? "selected" : null)" @onclick="() => FieldChanged.InvokeAsync(field)">
                @ProductListing.FieldLabel(field)
                <span class="trail">@if (selected) { <Icon Name="check" Size="18" /> }</span>
            </button>
        }
    </div>
    <Segmented TValue="SortDirection" AriaLabel="Direction" Options="DirectionOptions" Value="Direction" ValueChanged="DirectionChanged" />
    <button type="button" class="btn btn-primary" @onclick="OnClose">Done</button>
</BottomSheet>

@code {
    private static readonly ProductSortField[] _fields = [ProductSortField.Name, ProductSortField.Price, ProductSortField.CookingTime];

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public ProductSortField Field { get; set; }
    [Parameter] public EventCallback<ProductSortField> FieldChanged { get; set; }
    [Parameter] public SortDirection Direction { get; set; }
    [Parameter] public EventCallback<SortDirection> DirectionChanged { get; set; }

    // The direction labels follow the chosen field (A → Z / Low to high / Shortest first).
    private IReadOnlyList<SegmentedOption<SortDirection>> DirectionOptions =>
    [
        new(SortDirection.Asc, ProductListing.DirectionLabel(Field, SortDirection.Asc)),
        new(SortDirection.Desc, ProductListing.DirectionLabel(Field, SortDirection.Desc)),
    ];
}
