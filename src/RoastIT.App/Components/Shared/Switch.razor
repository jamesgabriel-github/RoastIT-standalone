<button type="button" class="switch @(Checked ? "on" : null)" role="switch" aria-checked="@(Checked ? "true" : "false")" aria-label="@AriaLabel" @onclick="ToggleAsync"><span></span></button>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = "";

    private Task ToggleAsync() => CheckedChanged.InvokeAsync(!Checked);
}
