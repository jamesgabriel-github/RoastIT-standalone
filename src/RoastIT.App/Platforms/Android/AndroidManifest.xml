<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android Auto Backup is off (D14): backups are manual export/import only. -->
    <application android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>
    <!-- No INTERNET permission is declared in release: the app is fully offline.
         Debug builds get it automatically from the MAUI tooling (hot reload / debugger). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
